generator client {
  provider = "prisma-client-js"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_URI")
}

model User {
  id       String @id @default(uuid())
  email    String @unique
  password String
  name     String @default("User")

  // Статус аккаунта
  isActive        Boolean @default(true)
  isEmailVerified Boolean @default(false)

  // Премиум функции
  isPremium        Boolean      @default(false)
  premiumExpiresAt DateTime?
  premiumPlan      PremiumPlan?

  // totp
  isTotpEnabled Boolean @default(false)
  totpSecret    String?

  // Метаданные
  lastLoginAt DateTime?
  loginCount  Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  role      Role     @default(USER)

  // Токены
  tokens     Token[]
  accounts   Account[]
  tags       Tag[]
  categories Category[]
}

enum PremiumPlan {
  MONTHLY
  YEARLY
  FOREVER
}

enum Role {
  USER
  ADMIN
}

model Token {
  id String @id @default(uuid())

  token     String    @unique
  type      TokenType
  expiresAt DateTime

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum TokenType {
  EMAIL_VERIFY
}

model Account {
  id       String  @id @default(uuid())
  name     String
  balance  Decimal @default(0)
  currency String

  icon      String @default("default")
  iconColor String @default("#000000")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  operations Operation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, name])
}

model Operation {
  id          String        @id @default(uuid())
  amount      Decimal
  date        DateTime      @default(now())
  description String?
  type        OperationType

  category   Category @relation(fields: [categoryId], references: [id])
  categoryId String

  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  accountId String

  tags Tag[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum OperationType {
  INCOME
  EXPENSE
  TRANSFER
}

model Tag {
  id     String @id @default(uuid())
  name   String
  color  String @default("#cccccc")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  operations Operation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, name])
}

model Category {
  id     String       @id @default(uuid())
  name   String
  type   CategoryType
  color  String       @default("#cccccc")
  icon   String       @default("default")
  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  // Для иерархии 
  parent   Category?  @relation("CategoryToParent", fields: [parentId], references: [id])
  parentId String?
  children Category[] @relation("CategoryToParent")

  operations Operation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, name])
}

enum CategoryType {
  INCOME
  EXPENSE
}
