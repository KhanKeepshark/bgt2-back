generator client {
  provider = "prisma-client-js"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_URI")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String   @default("User")

  defaultAccountId String?
  defaultAccount   Account? @relation("UserDefaultAccount", fields: [defaultAccountId], references: [id], onDelete: SetNull)
  
  isActive     Boolean @default(true)
  isEmailVerified Boolean @default(false)

  // Подписка - у пользователя всегда есть план
  subscriptionPlan   SubscriptionPlan @relation(fields: [subscriptionPlanId], references: [id], onDelete: Restrict)
  subscriptionPlanId String
  subscriptionStartedAt DateTime @default(now())
  subscriptionExpiresAt DateTime? // null = бессрочно

  isTotpEnabled Boolean @default(false)
  totpSecret String?
  
  lastLoginAt DateTime?
  loginCount  Int      @default(0)

  tokensBalance Int @default(0)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  role      Role     @default(USER)
  // Прочитанные глобальные уведомления (id из Notification)
  readGlobalNotificationIds String[] @default([])
  
  tokens Token[]
  accounts Account[]
  tags Tag[]
  categories Category[]
  categoryKeywords CategoryKeyword[]
  operations Operation[]
  recurrenceConfigs RecurrenceConfig[]
  aiTokenUsages AiTokenUsage[]
  notifications Notification[]
  
  @@index([subscriptionPlanId])
}

model SubscriptionPlan {
  id            String   @id @default(uuid())
  name          String   @unique // "Free", "Basic", "Premium", "Pro"
  description   String?
  
  // Лимиты токенов
  tokensPerMonth Int?    // null = безлимит
  tokensOnPurchase Int   @default(0) // Токены при покупке плана
  
  // Лимиты ресурсов (общие - всего)
  maxOperations Int?    // null = безлимит (всего операций)
  maxCategories Int?    // null = безлимит (всего категорий)
  maxAccounts Int?      // null = безлимит (всего счетов/бюджетов)
  maxTags Int?          // null = безлимит (всего тегов)
  maxRecurrenceConfigs Int? // null = безлимит (всего повторяющихся операций)
  
  // Периодические лимиты (в месяц)
  maxOperationsPerMonth Int? // null = безлимит (операций в месяц)
  
  // Лимиты на связи (на один родительский ресурс)
  maxCategoryKeywordsPerCategory Int? // null = безлимит (ключевых слов на категорию)
  
  // Цена и длительность
  price         Decimal?
  currency      String   @default("USD")
  durationDays  Int?     // null = бессрочно
  
  // Дополнительные возможности (типизированные Boolean поля)
  canUseAiOperations Boolean @default(false)  // Загрузка операций через AI
  canExportData      Boolean @default(false)  // Экспорт в Excel
  canUseRecurring    Boolean @default(false)  // Повторяющиеся операции
  
  // Статус
  isActive      Boolean  @default(true)
  
  // Связи
  users         User[]
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  @@index([isActive])
}

enum Role {
  USER
  ADMIN
}

model Token {
  id        String   @id @default(uuid())

  token     String @unique
  type      TokenType
  expiresAt DateTime

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@index([userId, type, expiresAt])
  @@index([expiresAt])
}

enum TokenType {
  EMAIL_VERIFY
}

model Account {
  id        String   @id @default(uuid())
  name      String
  initialBalance   Decimal  @default(0)
  balance   Decimal  @default(0)
  currency  String

  icon      String @default("default")
  iconColor String @default("#000000")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String

  operations                Operation[] @relation("OperationAccount")
  transferOperations        Operation[] @relation("OperationTransferAccount")
  recurrenceConfigs         RecurrenceConfig[] @relation("RecurrenceAccount")
  transferRecurrenceConfigs RecurrenceConfig[] @relation("RecurrenceTransferAccount")
  defaultForUsers           User[] @relation("UserDefaultAccount")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, name])
  @@index([userId])
}

model Operation {
  id          String      @id @default(uuid())
  amount      Decimal
  date        DateTime    @default(now())
  description String?
  type        OperationType

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String

  account           Account? @relation("OperationAccount", fields: [accountId], references: [id], onDelete: SetNull)
  accountId         String?
  transferAccount   Account? @relation("OperationTransferAccount", fields: [transferAccountId], references: [id], onDelete: SetNull)
  transferAccountId String?
  
  category    Category?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  categoryId  String?

  recurrenceConfig   RecurrenceConfig? @relation(fields: [recurrenceConfigId], references: [id], onDelete: SetNull)
  recurrenceConfigId String?

  tags Tag[]

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  
  @@index([userId])
  @@index([userId, date])
  @@index([userId, type])
  @@index([date])
  @@index([accountId])
  @@index([categoryId])
}

model RecurrenceConfig {
  id          String   @id @default(uuid())
  
  frequency   RecurrenceFrequency
  interval    Int      
  weekDays    Int[]    
  
  date        DateTime
  amount      Decimal
  description String?
  type        OperationType
  
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  
  account           Account? @relation("RecurrenceAccount", fields: [accountId], references: [id], onDelete: SetNull)
  accountId         String?
  transferAccount   Account? @relation("RecurrenceTransferAccount", fields: [transferAccountId], references: [id], onDelete: SetNull)
  transferAccountId String?
  
  category    Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  categoryId  String?
  
  operations  Operation[]
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  @@index([userId])
}

enum OperationType {
  INCOME
  EXPENSE
  TRANSFER
}

enum RecurrenceFrequency {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

model Tag {
  id        String   @id @default(uuid())
  name      String
  color     String   @default("#cccccc")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String

  operations Operation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, name])
  @@index([userId])
}

model Category {
  id        String   @id @default(uuid())
  name      String
  type      CategoryType
  color     String   @default("#cccccc")
  icon      String   @default("default")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String

  keywords  CategoryKeyword[]

  parent    Category? @relation("CategoryToParent", fields: [parentId], references: [id])
  parentId  String?
  children  Category[] @relation("CategoryToParent")

  operations        Operation[]
  recurrenceConfigs RecurrenceConfig[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, name])
  @@index([userId])
  @@index([userId, type])
  @@index([parentId])
}

model CategoryKeyword {
  id         String   @id @default(uuid())
  phrase     String
  
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  categoryId String
  
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, phrase])
  @@index([userId])
  @@index([categoryId])
}

enum CategoryType {
  INCOME
  EXPENSE
}

model AiTokenUsage {
  id        String   @id @default(uuid())
  
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  
  // Сколько токенов планировалось потратить (оценка)
  estimatedTokens Int
  
  // Сколько токенов потратили по факту
  actualTokens Int
  
  // Сколько операций было создано в результате
  operationsCreated Int @default(0)
  
  // Тип файла, который обрабатывался
  fileType  String? // mimetype
  
  // Статус операции
  status    AiUsageStatus @default(SUCCESS)
  
  // Ошибка, если была
  error     String?
  
  createdAt DateTime @default(now())
  
  @@index([userId])
  @@index([userId, createdAt])
  @@index([createdAt])
}

enum AiUsageStatus {
  SUCCESS
  FAILED
}

model Notification {
  id          String   @id @default(uuid())
  title       String
  description String
  link        String?
  buttonText  String

  // scope = USER -> персональное уведомление, scope = GLOBAL -> глобальное
  scope       NotificationScope @default(USER)

  // Для персональных уведомлений
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String?

  isRead      Boolean  @default(false)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([userId])
  @@index([createdAt])
}

enum NotificationScope {
  GLOBAL
  USER
}
