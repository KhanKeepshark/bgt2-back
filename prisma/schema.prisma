generator client {
  provider = "prisma-client-js"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_URI")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique @db.VarChar(255)
  password  String   @db.VarChar(255)
  name      String   @default("User") @db.VarChar(100)

  defaultAccountId String?   @unique // Аккаунт может быть дефолтным только для одного пользователя
  defaultAccount   Account? @relation("UserDefaultAccount", fields: [defaultAccountId], references: [id], onDelete: SetNull)
  
  isActive     Boolean @default(true)
  isEmailVerified Boolean @default(false)

  // Подписка - у пользователя всегда есть план
  subscriptionPlan   SubscriptionPlan @relation(fields: [subscriptionPlanId], references: [id], onDelete: Restrict)
  subscriptionPlanId String
  
  // Конкретный вариант цены/длительности, который выбрал пользователь
  subscriptionPrice   SubscriptionPrice? @relation(fields: [subscriptionPriceId], references: [id], onDelete: SetNull)
  subscriptionPriceId String?

  subscriptionStartedAt DateTime @default(now())
  subscriptionExpiresAt DateTime? // null = бессрочно
  /// When false, Premium stays active until subscriptionExpiresAt but will not auto-renew.
  subscriptionAutoRenew Boolean @default(false)

  isTotpEnabled Boolean @default(false)
  totpSecret String?
  
  lastLoginAt DateTime?
  loginCount  Int      @default(0)

  tokensBalance Int @default(0)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  role      Role     @default(USER)
  welcomeSheetSeenAt DateTime?
  operationsArchivalNotifiedAt DateTime?

  tokens Token[]
  accounts Account[]
  tags Tag[]
  categories Category[]
  categoryKeywords CategoryKeyword[]
  keywordFilters   KeywordFilter[]
  operations Operation[]
  operationMonthlyRollups OperationMonthlyRollup[]
  recurrenceConfigs RecurrenceConfig[]
  aiTokenUsages AiTokenUsage[]
  aiUploadTasks AiUploadTask[]
  activityEvents UserActivityEvent[]
  notifications Notification[]
  inboxMessageReads InboxMessageRead[]
  payments      Payment[]
  supportTickets SupportTicket[]
  consents       UserConsent[]
  
  @@index([subscriptionPlanId])
  @@index([subscriptionPriceId])
}

enum SubscriptionType {
  FREE
  PREMIUM
}

model SubscriptionPlan {
  id            String   @id @default(uuid())
  type          SubscriptionType @unique
  description   String? @db.VarChar(255)
  
  // Лимиты токенов
  tokensPerMonth Int?    // null = безлимит
  tokensOnPurchase Int   @default(0) // Токены при покупке плана
  
  // Лимиты ресурсов (общие - всего)
  maxCategories Int?    // null = безлимит (всего категорий)
  maxAccounts Int?      // null = безлимит (всего счетов/бюджетов)
  maxTags Int?          // null = безлимит (всего тегов)
  maxRecurrenceConfigs Int? // null = безлимит (всего повторяющихся операций)
  
  // Периодические лимиты (в месяц)
  maxOperationsPerMonth Int? // null = безлимит (операций в месяц)
  
  // Лимиты на связи (на один родительский ресурс)
  maxCategoryKeywordsPerCategory Int? // null = безлимит (ключевых слов на категорию)
  
  // Дополнительные возможности (типизированные Boolean поля)
  canExportData      Boolean @default(false)  // Экспорт в Excel
  canUseAutoCategory Boolean @default(false)  // Автоматическая категория
  
  // Статус
  isActive      Boolean  @default(true)
  
  // Связи
  prices        SubscriptionPrice[]
  users         User[]
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  @@index([isActive])
}

model SubscriptionPrice {
  id           String   @id @default(uuid())
  
  plan         SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  planId       String

  name         String   @db.VarChar(50) // "Monthly", "Yearly", "Free"
  price        Decimal
  currency     String   @default("USD") @db.VarChar(5)
  durationDays Int?     // null = бессрочно

  users        User[]
  payments     Payment[]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([planId])
}

enum Role {
  USER
  ADMIN
}

model Token {
  id        String   @id @default(uuid())

  token     String @unique
  type      TokenType
  expiresAt DateTime

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@index([userId, type, expiresAt])
  @@index([expiresAt])
}

enum TokenType {
  EMAIL_VERIFY
  PASSWORD_RESET
}

model Account {
  id        String   @id @default(uuid())
  name      String   @db.VarChar(50)
  initialBalance   Decimal  @default(0)
  balance   Decimal  @default(0)
  currency  String   @db.VarChar(5)

  icon      String @default("default") @db.VarChar(50)
  iconColor String @default("#000000") @db.VarChar(9)

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String

  operations                Operation[] @relation("OperationAccount")
  transferOperations        Operation[] @relation("OperationTransferAccount")
  recurrenceConfigs         RecurrenceConfig[] @relation("RecurrenceAccount")
  transferRecurrenceConfigs RecurrenceConfig[] @relation("RecurrenceTransferAccount")
  defaultForUser             User?  @relation("UserDefaultAccount")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, name])
  @@index([userId])
}

model Operation {
  id          String      @id @default(uuid())
  amount      Decimal
  date        DateTime    @default(now())
  description String?     @db.VarChar(255)
  type        OperationType

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String

  account           Account? @relation("OperationAccount", fields: [accountId], references: [id], onDelete: Cascade)
  accountId         String?
  transferAccount   Account? @relation("OperationTransferAccount", fields: [transferAccountId], references: [id], onDelete: Cascade)
  transferAccountId String?
  
  category    Category?    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  categoryId  String?

  recurrenceConfig   RecurrenceConfig? @relation(fields: [recurrenceConfigId], references: [id], onDelete: SetNull)
  recurrenceConfigId String?

  tags Tag[]

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  
  @@index([userId, date])
  @@index([userId, type])
  @@index([userId, accountId])
  @@index([userId, categoryId])
  @@index([accountId])
  @@index([categoryId])
}

model OperationMonthlyRollup {
  id             String        @id @default(uuid())
  userId         String
  yearMonth      DateTime
  type           OperationType
  categoryId     String?
  accountId      String?
  totalAmount    Decimal
  operationCount Int
  categoryName   String?       @db.VarChar(100)
  categoryIcon   String?       @db.VarChar(50)
  accountName    String?       @db.VarChar(100)

  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime      @default(now())

  @@index([userId, yearMonth])
}

model RecurrenceConfig {
  id          String   @id @default(uuid())
  
  frequency   RecurrenceFrequency
  interval    Int      
  weekDays    Int[]    
  
  date        DateTime
  amount      Decimal
  description String? @db.VarChar(255)
  type        OperationType
  
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  
  account           Account? @relation("RecurrenceAccount", fields: [accountId], references: [id], onDelete: Cascade)
  accountId         String?
  transferAccount   Account? @relation("RecurrenceTransferAccount", fields: [transferAccountId], references: [id], onDelete: Cascade)
  transferAccountId String?
  
  category    Category? @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  categoryId  String?
  
  operations  Operation[]
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  @@index([userId])
}

enum OperationType {
  INCOME
  EXPENSE
  TRANSFER
}

enum RecurrenceFrequency {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

model Tag {
  id        String   @id @default(uuid())
  name      String   @db.VarChar(50)
  color     String   @default("#cccccc") @db.VarChar(9)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String

  operations Operation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, name])
  @@index([userId])
}

model Category {
  id        String   @id @default(uuid())
  name      String   @db.VarChar(50)
  type      CategoryType
  color     String   @default("#cccccc") @db.VarChar(9)
  icon      String   @default("default") @db.VarChar(50)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String

  keywords  CategoryKeyword[]

  parent    Category? @relation("CategoryToParent", fields: [parentId], references: [id])
  parentId  String?
  children  Category[] @relation("CategoryToParent")

  operations        Operation[]
  recurrenceConfigs RecurrenceConfig[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, name])
  @@index([userId])
  @@index([userId, type])
  @@index([parentId])
}

model CategoryKeyword {
  id         String   @id @default(uuid())
  phrase     String   @db.VarChar(100)
  
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  categoryId String
  
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, phrase])
  @@index([userId])
  @@index([categoryId])
}

model KeywordFilter {
  id         String   @id @default(uuid())
  phrase     String   @db.VarChar(100)
  type       KeywordFilterType
  
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, phrase, type])
  @@index([userId])
}

enum KeywordFilterType {
  DELETE
}

enum CategoryType {
  INCOME
  EXPENSE
}

model AiUploadTask {
  id        String             @id @default(uuid())
  userId    String
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  status    AiUploadTaskStatus @default(PENDING)
  result    Json?
  error     String?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
}

enum AiUploadTaskStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model AiTokenUsage {
  id        String   @id @default(uuid())
  
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  
  // Сколько токенов планировалось потратить (оценка)
  estimatedTokens Int
  
  // Сколько токенов потратили по факту
  actualTokens Int
  
  // Сколько операций было создано в результате
  operationsCreated Int @default(0)
  
  // Тип файла, который обрабатывался
  fileType  String? @db.VarChar(50) // mimetype
  
  // Статус операции
  status    AiUsageStatus @default(SUCCESS)
  
  // Ошибка, если была
  error     String?
  
  createdAt DateTime @default(now())
  
  @@index([userId])
  @@index([userId, createdAt])
  @@index([createdAt])
}

enum AiUsageStatus {
  SUCCESS
  FAILED
}

model UserActivityEvent {
  id     String @id @default(uuid())
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  type   UserActivityEventType
  status UserActivityEventStatus
  error  String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([userId, type])
  @@index([userId, createdAt])
}

enum UserActivityEventType {
  EXPORT
}

enum UserActivityEventStatus {
  SUCCESS
  FAILED
}

model Notification {
  id          String   @id @default(uuid())
  title       Json     // { en, ru, kz }
  description Json     // { en, ru, kz }
  link        String?  @db.VarChar(255)
  buttonText  Json     // { en, ru, kz }

  // scope = USER -> персональное уведомление, scope = GLOBAL -> глобальное
  scope       NotificationScope @default(USER)

  // Для персональных уведомлений
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String?

  isRead      Boolean  @default(false)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  inboxMessageReads InboxMessageRead[]
  
  @@index([userId])
  @@index([createdAt])
}

model InboxMessageRead {
  userId         String
  notificationId String
  readAt         DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@id([userId, notificationId])
  @@index([notificationId])
}

enum NotificationScope {
  GLOBAL
  USER
}

model SystemMetric {
  id        String   @id @default(uuid())
  date      DateTime @default(now()) // Время снятия метрики

  // Пользовательские метрики
  totalUsers Int
  activeUsersDaily Int    // За 24 часа
  
  // Метрики по подпискам (JSON: { "Free": 100, "Premium": 20 })
  usersByPlan Json

  // Метрики активности
  totalOperations Int
  operationsCreatedDaily Int

  totalCategories Int @default(0)
  totalAccounts Int @default(0)

  // AI метрики
  aiTokensUsedDaily Int

  createdAt DateTime @default(now())
  
  @@index([date])
}

model Payment {
  id            String   @id @default(uuid())
  amount        Decimal
  currency      String   @default("RUB")
  status        PaymentStatus @default(PENDING)
  provider      String   @default("")
  externalId    String?  // Transaction ID from payment provider
  
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String

  subscriptionPrice   SubscriptionPrice? @relation(fields: [subscriptionPriceId], references: [id])
  subscriptionPriceId String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
  @@index([externalId])
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  CANCELLED
}

model SupportTicket {
  id           String   @id @default(uuid())
  email        String   @db.VarChar(255)
  message      String   @db.Text
  replyMessage String?  @db.Text
  status       SupportTicketStatus @default(OPEN)
  
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId       String?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([email])
  @@index([status])
  @@index([userId])
  @@index([createdAt])
}

enum SupportTicketStatus {
  OPEN
  RESOLVED
}

enum ConsentType {
  TERMS
  PRIVACY
  CROSS_BORDER_PD
}

model UserConsent {
  id         String      @id @default(uuid())
  userId     String
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       ConsentType
  version    String      @db.VarChar(32)
  acceptedAt DateTime    @default(now())
  ipAddress  String?     @db.VarChar(45)
  userAgent  String?     @db.VarChar(512)

  @@index([userId, type])
}

