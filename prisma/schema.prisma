generator client {
  provider = "prisma-client-js"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_URI")
}
model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String   @default("User")

  defaultAccountId String?
  
  isActive     Boolean @default(true)
  isEmailVerified Boolean @default(false)

  isPremium    Boolean @default(false)
  premiumExpiresAt DateTime?
  premiumPlan   PremiumPlan?

  isTotpEnabled Boolean @default(false)
  totpSecret String?
  
  lastLoginAt DateTime?
  loginCount  Int      @default(0)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  role      Role     @default(USER)
  
  tokens Token[]
  accounts Account[]
  tags Tag[]
  categories Category[]
  operations Operation[]
  recurrenceConfigs RecurrenceConfig[]
}

enum PremiumPlan {
  MONTHLY
  YEARLY
  FOREVER
}

enum Role {
  USER
  ADMIN
}

model Token {
  id        String   @id @default(uuid())

  token     String @unique
  type      TokenType
  expiresAt DateTime

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum TokenType {
  EMAIL_VERIFY
}

model Account {
  id        String   @id @default(uuid())
  name      String
  balance   Decimal  @default(0)
  currency  String

  icon      String @default("default")
  iconColor String @default("#000000")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String

  operations                Operation[] @relation("OperationAccount")
  transferOperations        Operation[] @relation("OperationTransferAccount")
  recurrenceConfigs         RecurrenceConfig[] @relation("RecurrenceAccount")
  transferRecurrenceConfigs RecurrenceConfig[] @relation("RecurrenceTransferAccount")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, name])
}

model Operation {
  id          String      @id @default(uuid())
  amount      Decimal
  date        DateTime    @default(now())
  description String?
  type        OperationType

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String

  account           Account? @relation("OperationAccount", fields: [accountId], references: [id], onDelete: SetNull)
  accountId         String?
  transferAccount   Account? @relation("OperationTransferAccount", fields: [transferAccountId], references: [id], onDelete: SetNull)
  transferAccountId String?
  
  category    Category?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  categoryId  String?

  recurrenceConfig   RecurrenceConfig? @relation(fields: [recurrenceConfigId], references: [id], onDelete: SetNull)
  recurrenceConfigId String?

  tags Tag[]

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model RecurrenceConfig {
  id          String   @id @default(uuid())
  
  frequency   RecurrenceFrequency
  interval    Int      
  weekDays    Int[]    
  
  date        DateTime
  amount      Decimal
  description String?
  type        OperationType
  
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  
  account           Account? @relation("RecurrenceAccount", fields: [accountId], references: [id], onDelete: SetNull)
  accountId         String?
  transferAccount   Account? @relation("RecurrenceTransferAccount", fields: [transferAccountId], references: [id], onDelete: SetNull)
  transferAccountId String?
  
  category    Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  categoryId  String?
  
  operations  Operation[]
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

enum OperationType {
  INCOME
  EXPENSE
  TRANSFER
}

enum RecurrenceFrequency {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

model Tag {
  id        String   @id @default(uuid())
  name      String
  color     String   @default("#cccccc")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String

  operations Operation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, name])
}

model Category {
  id        String   @id @default(uuid())
  name      String
  type      CategoryType
  color     String   @default("#cccccc")
  icon      String   @default("default")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String

  parent    Category? @relation("CategoryToParent", fields: [parentId], references: [id])
  parentId  String?
  children  Category[] @relation("CategoryToParent")

  operations        Operation[]
  recurrenceConfigs RecurrenceConfig[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, name])
}

enum CategoryType {
  INCOME
  EXPENSE
}