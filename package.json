    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^4.17.17",
    "@types/express-session": "^1.18.1",
    "@types/geoip-lite": "^1.4.4",
    "@types/jest": "^29.5.2",
    "@types/node": "^20.3.1",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.1.8",
    "@types/supertest": "^6.0.0",
    "@types/uuid": "^10.0.0",
