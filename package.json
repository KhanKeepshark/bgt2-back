  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/apps/back/main",
    "start:back": "nest start back",
    "start:back:dev": "nest start back --watch",
    "start:rabbitmq": "nest start rabbitmq-service",
    "start:rabbitmq:dev": "nest start rabbitmq-service --watch",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./apps/back/test/jest.config.json",
    "db:push": "prisma db push",
    "db:studio": "prisma studio"
  },
